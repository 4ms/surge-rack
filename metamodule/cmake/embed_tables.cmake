# cmake -DSURGE_DIR=<surge> -DOUT=<file.cpp> -P embed_tables.cmake
# Embeds Surge's default wavetable and window table byte-for-byte as
# surge_mm::{default,window}_table (see dsp/table_data.cpp).
set(tables
    default_table "${SURGE_DIR}/resources/data/wavetables/Basic/Sine To Sawtooth.wt"
    window_table "${SURGE_DIR}/resources/surge-shared/windows.wt")
set(src "// Generated by embed_tables.cmake from surge/resources. GPL-3.0-or-later.\n")
string(APPEND src "#include <cstddef>\n#include <cstdint>\nnamespace surge_mm\n{\n")
list(LENGTH tables n)
math(EXPR last "${n} - 1")
foreach(i RANGE 0 ${last} 2)
    math(EXPR j "${i} + 1")
    list(GET tables ${i} sym)
    list(GET tables ${j} path)
    file(READ "${path}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND src "extern const uint8_t ${sym}[] = {${bytes}};\n")
    string(APPEND src "extern const size_t ${sym}_size = sizeof(${sym});\n")
endforeach()
string(APPEND src "} // namespace surge_mm\n")
# Only touch the output when the content changes.
file(CONFIGURE OUTPUT "${OUT}" CONTENT "${src}" @ONLY)
